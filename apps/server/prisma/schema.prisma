// FleetForce Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// AUTHENTICATION & AUTHORIZATION
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          Role      @relation(fields: [roleId], references: [id])
  roleId        String
  branch        Branch?   @relation(fields: [branchId], references: [id])
  branchId      String?
  department    Department? @relation(fields: [departmentId], references: [id])
  departmentId  String?
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // admin, manager, supervisor, dispatcher, driver, operator
  displayName String
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  module   String // fleet, drivers, trips, maintenance, etc.
  action   String // create, read, update, delete
  role     Role   @relation(fields: [roleId], references: [id])
  roleId   String

  @@unique([roleId, module, action])
  @@map("permissions")
}

// ═══════════════════════════════════════════════════════════════
// ORGANIZATION
// ═══════════════════════════════════════════════════════════════

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  country   String?  @default("India")
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  vehicles    Vehicle[]
  drivers     Driver[]
  departments Department[]

  @@map("branches")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("departments")
}

// ═══════════════════════════════════════════════════════════════
// FLEET MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model VehicleCategory {
  id          String  @id @default(cuid())
  name        String  @unique // Excavator, Backhoe Loader, Bulldozer, etc.
  description String?
  icon        String? // Icon identifier
  wheels      Int?
  weightKg    Float?
  capacityKg  Float?
  fuelType    String? // diesel, petrol, electric, hybrid
  attachments String[] // bucket, hammer, auger, etc.
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles Vehicle[]

  @@map("vehicle_categories")
}

model Vehicle {
  id                String          @id @default(cuid())
  vehicleNumber     String          @unique // AP39AB1234
  registrationNumber String         @unique
  category          VehicleCategory @relation(fields: [categoryId], references: [id])
  categoryId        String
  brand             String          // JCB, Caterpillar, Komatsu, etc.
  model             String
  manufactureYear   Int
  engineNumber      String?
  chassisNumber     String?
  fuelType          String          // diesel, petrol, electric, hybrid
  color             String?
  purchaseDate      DateTime?
  purchasePrice     Float?
  insuranceExpiry   DateTime?
  fitnessExpiry     DateTime?
  pollutionExpiry   DateTime?
  status            VehicleStatus   @default(AVAILABLE)
  image             String?
  documents         String[]        // Array of document URLs
  qrCode            String?
  branch            Branch?         @relation(fields: [branchId], references: [id])
  branchId          String?
  isArchived        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  gpsDevice         GpsDevice?
  driver            Driver?         @relation("AssignedVehicle")
  trips             Trip[]
  maintenanceRecords MaintenanceRecord[]
  fuelEntries       FuelEntry[]
  alerts            Alert[]
  locations         Location[]

  @@map("vehicles")
}

enum VehicleStatus {
  AVAILABLE
  RUNNING
  IDLE
  MAINTENANCE
  BREAKDOWN
  RETIRED
}

// ═══════════════════════════════════════════════════════════════
// GPS TRACKING
// ═══════════════════════════════════════════════════════════════

model GpsDevice {
  id           String   @id @default(cuid())
  deviceId     String   @unique
  imei         String?  @unique
  simNumber    String?
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId    String   @unique
  isOnline     Boolean  @default(false)
  lastPing     DateTime?
  batteryLevel Float?
  firmwareVersion String?
  installedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("gps_devices")
}

model Location {
  id          String   @id @default(cuid())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId   String
  latitude    Float
  longitude   Float
  altitude    Float?
  speed       Float?   @default(0) // km/h
  heading     Float?   // compass direction 0-360
  engineOn    Boolean  @default(false)
  fuelLevel   Float?   // percentage 0-100
  address     String?
  timestamp   DateTime @default(now())

  @@index([vehicleId, timestamp])
  @@map("locations")
}

model GeoFence {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("circle") // circle, polygon
  // For circle: center lat/lng + radius
  centerLat   Float?
  centerLng   Float?
  radiusMeters Float?
  // For polygon: array of coordinates as JSON
  coordinates Json?
  isActive    Boolean  @default(true)
  alertOnEntry Boolean @default(true)
  alertOnExit  Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("geo_fences")
}

// ═══════════════════════════════════════════════════════════════
// DRIVER MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model Driver {
  id              String       @id @default(cuid())
  employeeId      String       @unique
  firstName       String
  lastName        String
  photo           String?
  phone           String
  email           String?
  emergencyContact String?
  emergencyPhone  String?
  address         String?
  city            String?
  state           String?
  dateOfBirth     DateTime?
  bloodGroup      String?      // A+, A-, B+, B-, O+, O-, AB+, AB-
  licenseNumber   String       @unique
  licenseType     String?      // HMV, LMV, etc.
  licenseExpiry   DateTime
  experience      Int?         @default(0) // years
  skills          String[]     // excavator, crane, bulldozer, etc.
  status          DriverStatus @default(AVAILABLE)
  assignedVehicle Vehicle?     @relation("AssignedVehicle", fields: [assignedVehicleId], references: [id])
  assignedVehicleId String?    @unique
  documents       String[]     // Array of document URLs
  medicalCertExpiry DateTime?
  branch          Branch?      @relation(fields: [branchId], references: [id])
  branchId        String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  trips           Trip[]
  attendance      DriverAttendance[]
  performance     DriverPerformance[]

  @@map("drivers")
}

enum DriverStatus {
  AVAILABLE
  ON_DUTY
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

model DriverAttendance {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id])
  driverId  String
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String   @default("present") // present, absent, late, half_day
  hoursWorked Float?
  notes     String?
  createdAt DateTime @default(now())

  @@unique([driverId, date])
  @@map("driver_attendance")
}

model DriverPerformance {
  id              String   @id @default(cuid())
  driver          Driver   @relation(fields: [driverId], references: [id])
  driverId        String
  month           DateTime // First day of the month
  totalTrips      Int      @default(0)
  totalDistance    Float    @default(0) // km
  totalHours      Float    @default(0)
  avgSpeed        Float    @default(0) // km/h
  fuelEfficiency  Float?   // km/l
  overspeedCount  Int      @default(0)
  hardBrakeCount  Int      @default(0)
  idleTimeMinutes Int      @default(0)
  score           Float    @default(100) // 0-100
  createdAt       DateTime @default(now())

  @@unique([driverId, month])
  @@map("driver_performance")
}

// ═══════════════════════════════════════════════════════════════
// TRIP MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model Trip {
  id            String     @id @default(cuid())
  tripNumber    String     @unique
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
  vehicleId     String
  driver        Driver     @relation(fields: [driverId], references: [id])
  driverId      String
  startLocation String
  startLat      Float?
  startLng      Float?
  endLocation   String?
  endLat        Float?
  endLng        Float?
  startTime     DateTime
  endTime       DateTime?
  distance      Float?     // km
  duration      Int?       // minutes
  fuelUsed      Float?     // liters
  avgSpeed      Float?     // km/h
  maxSpeed      Float?     // km/h
  status        TripStatus @default(PLANNED)
  route         Json?      // Array of lat/lng waypoints
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("trips")
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════
// MAINTENANCE
// ═══════════════════════════════════════════════════════════════

model MaintenanceRecord {
  id              String            @id @default(cuid())
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id])
  vehicleId       String
  type            MaintenanceType
  title           String
  description     String?
  scheduledDate   DateTime?
  completedDate   DateTime?
  status          MaintenanceStatus @default(SCHEDULED)
  cost            Float?
  workshop        String?
  technician      String?
  partsUsed       Json?             // Array of {partId, partName, quantity, cost}
  odometerReading Float?
  nextServiceDue  DateTime?
  nextServiceKm   Float?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("maintenance_records")
}

enum MaintenanceType {
  SCHEDULED
  PREVENTIVE
  CORRECTIVE
  BREAKDOWN
  INSPECTION
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

// ═══════════════════════════════════════════════════════════════
// INVENTORY
// ═══════════════════════════════════════════════════════════════

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  category      String   // engine_parts, hydraulic_parts, tyres, filters, oil, grease, tools, safety, spare_parts
  description   String?
  unit          String   @default("pcs") // pcs, liters, kg, meters
  currentStock  Int      @default(0)
  minStock      Int      @default(5)
  maxStock      Int?
  unitPrice     Float    @default(0)
  location      String?  // warehouse location
  barcode       String?
  qrCode        String?
  image         String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  supplierId    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  item        InventoryItem @relation(fields: [itemId], references: [id])
  itemId      String
  type        String   // purchase, issue, return, adjustment
  quantity    Int
  unitPrice   Float?
  totalPrice  Float?
  reference   String?  // PO number, issue ticket, etc.
  notes       String?
  performedBy String?
  createdAt   DateTime @default(now())

  @@map("inventory_transactions")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  contact   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  gstNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]

  @@map("suppliers")
}

// ═══════════════════════════════════════════════════════════════
// FUEL MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model FuelEntry {
  id            String   @id @default(cuid())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId     String
  date          DateTime
  fuelType      String   // diesel, petrol
  quantity      Float    // liters
  pricePerLiter Float
  totalCost     Float
  odometer      Float?   // km
  station       String?
  filledBy      String?
  receipt       String?  // receipt image URL
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("fuel_entries")
}

// ═══════════════════════════════════════════════════════════════
// ALERTS & NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════

model Alert {
  id          String      @id @default(cuid())
  type        AlertType
  severity    String      @default("medium") // low, medium, high, critical
  title       String
  message     String
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id])
  vehicleId   String?
  data        Json?       // Additional alert data
  isRead      Boolean     @default(false)
  isResolved  Boolean     @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("alerts")
}

enum AlertType {
  OVERSPEED
  GEOFENCE_EXIT
  GEOFENCE_ENTER
  IDLE_TIME
  MAINTENANCE_DUE
  INSURANCE_EXPIRY
  LICENSE_EXPIRY
  FUEL_LOW
  ENGINE_FAULT
  GPS_OFFLINE
  BATTERY_LOW
  SOS
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, warning, error, success
  link      String?  // Link to related page
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════
// SETTINGS & LOGS
// ═══════════════════════════════════════════════════════════════

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String   @default("general") // general, company, theme, notifications
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String   // create, update, delete, login, logout
  module     String   // vehicles, drivers, trips, etc.
  entityId   String?
  entityType String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([module, createdAt])
  @@map("audit_logs")
}
